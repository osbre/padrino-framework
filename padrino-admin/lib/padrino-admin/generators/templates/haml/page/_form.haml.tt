<%- @orm.column_fields.each_with_index do |column, index| -%>
- error = <%= @orm.has_error(column[:name]) %>
<%- if column[:field_type] == :check_box -%>
.form-check.mb-3
  = f.check_box :<%= column[:name] %>, class: "form-check-input#{' is-invalid' if error}"
  = f.label :<%= column[:name] %>, class: 'form-check-label'
  = f.error_message_on :<%= column[:name] %>, tag: :div, class: 'invalid-feedback'
<%- else -%>
.mb-3
  = f.label :<%= column[:name] %>, class: 'form-label'
  <% if column[:field_type] == :text_area %>~<% else %>=<% end %> f.<%= column[:field_type] %> :<%= column[:name] %>, class: "form-control#{' is-invalid' if error}"<%- if index == 0 -%>, autofocus: true<%- end -%>

  = f.error_message_on :<%= column[:name] %>, tag: :div, class: 'invalid-feedback'
<%- end -%>
<%- end -%>

.form-actions
  = link_to pat(:cancel), url(:<%= @orm.name_plural %>, :index), class: 'btn btn-outline-secondary'
  = f.submit pat(:save_and_continue), class: 'btn btn-outline-primary', name: 'save_and_continue'
  = f.submit pat(:save), class: 'btn btn-primary'
