doctype html
html lang='en'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    title = @title.present? ? "#{@title} | Padrino Admin" : "#{pat('login.title')} | Padrino Admin"
    javascript:
      document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    = favicon_tag 'favicon.ico'
    = stylesheet_link_tag 'bootstrap', 'fontawesome', 'application'

  body.bg-body-tertiary
    = form_tag url(:sessions, :create), class: 'login' do
      = image_tag 'logo.png', alt: "Padrino's logo", class: 'login-logo'
      .card.shadow-sm
        .card-body.p-4
          = { error: 'danger', warning: 'warning', success: 'success', notice: 'info' }.map { |type, class_name| flash_tag(type, class: "alert alert-#{class_name} alert-dismissible fade show", bootstrap: 5) }.join.html_safe
          .mb-3
            label.form-label for='email' = pat('login.email')
            = email_field_tag :email, id: :email, value: params[:email], autofocus: true, required: true, class: 'form-control'
          .mb-3
            label.form-label for='password' = pat('login.password')
            = password_field_tag :password, id: :password, required: true, class: 'form-control'
          .form-check.mb-4
            = check_box_tag :bypass, id: :bypass, class: 'form-check-input'
            label.form-check-label for='bypass' = pat('login.bypass')
          = submit_tag pat('login.sign_in'), class: 'btn btn-primary w-100'
    = javascript_include_tag 'bootstrap.bundle.min', 'application'
