doctype html
html lang='en'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    title = @title.present? ? "#{@title} | Padrino Admin" : 'Padrino Admin'
    javascript:
      document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    = favicon_tag 'favicon.ico'
    = stylesheet_link_tag 'bootstrap', 'fontawesome', 'application'

  body.bg-body-tertiary
    nav.navbar.navbar-expand-md.bg-body.border-bottom.sticky-top
      .container-xl
        = link_to 'Padrino', url(:base, :index), class: 'navbar-brand', title: 'Padrino Admin'
        button.navbar-toggler type='button' data-bs-toggle='collapse' data-bs-target='#navbar-modules' aria-controls='navbar-modules' aria-expanded='false' aria-label='Toggle navigation'
          span.navbar-toggler-icon
        #navbar-modules.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            - project_modules.each do |project_module|
              li.nav-item = link_to project_module.human_name, url(project_module.path), class: "nav-link#{' active' if request.path_info =~ /^#{project_module.path}/}"
          ul.navbar-nav
            li.nav-item = link_to tag_icon(:user), url(:<%= @model_plural %>, :edit, id: current_account.id), title: pat(:profile), class: 'nav-link'
            li.nav-item
              = button_to :logout, url(:sessions, :destroy), method: :delete, class: 'navbar-logout', submit_options: { type: :submit, title: pat(:logout), class: 'nav-link' } do
                = tag_icon('power-off')

    main.main.container-xl.py-4
      = { error: 'danger', warning: 'warning', success: 'success', notice: 'info' }.map { |type, class_name| flash_tag(type, class: "alert alert-#{class_name} alert-dismissible fade show", bootstrap: 5) }.join.html_safe
      = yield

    footer.border-top.bg-body.py-3
      .container-xl.d-flex.flex-wrap.justify-content-between.gap-2.small.text-body-secondary
        span Copyright &copy; #{Time.now.year} Your Site
        span
          ' Powered by
          = link_to "Padrino v#{Padrino.version}", 'https://padrinorb.com', class: 'link-secondary'
          '  &middot;
          = link_to 'GitHub', 'https://github.com/padrino/padrino-framework', class: 'link-secondary'

    = javascript_include_tag 'bootstrap.bundle.min', 'application'
