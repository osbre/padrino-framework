doctype html
html lang='en'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    title = @title.present? ? "#{@title} | Padrino Admin" : "#{pat('custom_errors.title')} | Padrino Admin"
    javascript:
      document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    = favicon_tag 'favicon.ico'
    = stylesheet_link_tag 'bootstrap', 'fontawesome', 'application'

  body.bg-body-tertiary
    .custom-error
      .custom-error-body = yield
      = link_to tag_icon('arrow-left', 'Go back'), '#', onclick: 'history.go(-1); return false;', class: 'btn btn-outline-secondary mt-3'
