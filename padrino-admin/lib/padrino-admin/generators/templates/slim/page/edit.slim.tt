ul.nav.nav-tabs
  li.nav-item = link_to tag_icon(:list, pat(:list)), url(:<%= @orm.name_plural %>, :index), class: 'nav-link'
  li.nav-item = link_to tag_icon(:plus, pat(:new)), url(:<%= @orm.name_plural %>, :new), class: 'nav-link'
  li.nav-item = link_to tag_icon('pen-to-square', pat(:edit)), url(:<%= @orm.name_plural %>, :edit, id: @<%= @orm.name_singular %>.id), class: 'nav-link active', 'aria-current' => 'page'

.tabs-content
  = form_for :<%= @orm.name_singular %>, url(:<%= @orm.name_plural %>, :update, id: @<%= @orm.name_singular %>.id), method: :put do |f|
    = partial '<%= @orm.name_plural %>/form', locals: { f: f }
