ul.nav.nav-tabs
  li.nav-item = link_to tag_icon(:list, pat(:list)), url(:<%= @orm.name_plural %>, :index), class: 'nav-link active', 'aria-current' => 'page'
  li.nav-item = link_to tag_icon(:plus, pat(:new)), url(:<%= @orm.name_plural %>, :new), class: 'nav-link'
  li.nav-item.list-bulk-item
    = form_tag url(:<%= @orm.name_plural %>, :destroy_many), method: :delete, class: 'list-bulk', hidden: true, 'data-confirm' => pat(:delete_selected_title) do
      = hidden_field_tag :<%= @orm.name_singular %>_ids, 'data-delete-many-ids' => true
      button.btn.btn-sm.btn-outline-danger type='submit'
        = tag_icon('trash-can', pat(:delete_selected))
        |  (<span class="list-bulk-count">0</span>)

.tabs-content
  .table-responsive
    table#list.table.table-hover.align-middle.mb-0
      thead
        tr
          th.list-selectable
            input.list-select-all.form-check-input type='checkbox' title=pat(:select_all) aria-label=pat(:select_all)
          <%- @orm.columns.each do |column| -%>
          th = mat(:<%= @orm.name_singular %>, :<%= column.name %>)
          <%- end -%>
          th.list-row-actions

      tbody
        - @<%= @orm.name_plural %>.each do |<%= @orm.name_singular %>|
          tr.list-row
            td.list-selectable = check_box_tag '<%= @orm.name_singular %>_ids[]', value: <%= @orm.name_singular %>.id, class: 'list-selectable-checkbox form-check-input'
            <%- @orm.columns.each do |column| -%>
            <%- if column.name == "created_at" || column.name == "updated_at" -%>
            td = time_ago_in_words <%= @orm.name_singular %>.<%= column.name %>
            <%- elsif column.type == :boolean -%>
            td = <%= @orm.name_singular %>.<%= column.name %> ? tag_icon(:check) : tag_icon(:xmark)
            <%- else -%>
            td = <%= @orm.name_singular %>.<%= column.name %>
            <%- end -%>
            <%- end -%>
            td.list-row-actions
              .list-row-actions-buttons
                = link_to tag_icon('pen-to-square'), url(:<%= @orm.name_plural %>, :edit, id: <%= @orm.name_singular %>.id), title: "#{pat(:edit)} <%= @orm.name_singular %>", class: 'btn btn-sm btn-outline-secondary'
                = form_tag url(:<%= @orm.name_plural %>, :destroy, id: <%= @orm.name_singular %>.id), method: :delete, 'data-confirm' => pat(:delete_title, model: '<%= @orm.name_singular %>') do
                  button.btn.btn-sm.btn-outline-danger type='submit' title="#{pat(:delete)} <%= @orm.name_singular %>" = tag_icon('trash-can')
