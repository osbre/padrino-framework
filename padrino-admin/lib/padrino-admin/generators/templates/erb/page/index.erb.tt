<ul class="nav nav-tabs">
  <li class="nav-item"><%%= link_to tag_icon(:list, pat(:list)), url(:<%= @orm.name_plural %>, :index), class: 'nav-link active', 'aria-current' => 'page' %></li>
  <li class="nav-item"><%%= link_to tag_icon(:plus, pat(:new)), url(:<%= @orm.name_plural %>, :new), class: 'nav-link' %></li>
  <li class="nav-item list-bulk-item">
    <%% form_tag url(:<%= @orm.name_plural %>, :destroy_many), method: :delete, class: 'list-bulk', hidden: true, 'data-confirm' => pat(:delete_selected_title) do %>
      <%%= hidden_field_tag :<%= @orm.name_singular %>_ids, 'data-delete-many-ids' => true %>
      <button type="submit" class="btn btn-sm btn-outline-danger"><%%= tag_icon('trash-can', pat(:delete_selected)) %> (<span class="list-bulk-count">0</span>)</button>
    <%% end %>
  </li>
</ul>
<div class="tabs-content">
  <div class="table-responsive">
    <table id="list" class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th class="list-selectable"><input type="checkbox" class="list-select-all form-check-input" title="<%%= pat(:select_all) %>" aria-label="<%%= pat(:select_all) %>"></th>
          <% @orm.columns.each do |column| -%>
          <th><%%= mat(:<%= @orm.name_singular %>, :<%= column.name %>) %></th>
          <% end -%>
          <th class="list-row-actions"></th>
        </tr>
      </thead>

      <tbody>
        <%% @<%= @orm.name_plural %>.each do |<%= @orm.name_singular %>| %>
          <tr class="list-row">
            <td class="list-selectable"><%%= check_box_tag '<%= @orm.name_singular %>_ids[]', value: <%= @orm.name_singular %>.id, class: 'list-selectable-checkbox form-check-input' %></td>
            <%- @orm.columns.each do |column| -%>
            <%- if column.name == "created_at" || column.name == "updated_at" -%>
            <td><%%= time_ago_in_words <%= @orm.name_singular %>.<%= column.name %> %></td>
            <%- elsif column.type == :boolean -%>
            <td><%%= <%= @orm.name_singular %>.<%= column.name %> ? tag_icon(:check) : tag_icon(:xmark) %></td>
            <%- else -%>
            <td><%%= <%= @orm.name_singular %>.<%= column.name %> %></td>
            <%- end -%>
            <%- end -%>
            <td class="list-row-actions">
              <div class="list-row-actions-buttons">
                <%%= link_to tag_icon('pen-to-square'), url(:<%= @orm.name_plural %>, :edit, id: <%= @orm.name_singular %>.id), title: "#{pat(:edit)} <%= @orm.name_singular %>", class: 'btn btn-sm btn-outline-secondary' %>
                <%% form_tag url(:<%= @orm.name_plural %>, :destroy, id: <%= @orm.name_singular %>.id), method: :delete, 'data-confirm' => pat(:delete_title, model: '<%= @orm.name_singular %>') do %>
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="<%%= pat(:delete) %> <%= @orm.name_singular %>"><%%= tag_icon('trash-can') %></button>
                <%% end %>
              </div>
            </td>
          </tr>
        <%% end %>
      </tbody>
    </table>
  </div>
</div>
