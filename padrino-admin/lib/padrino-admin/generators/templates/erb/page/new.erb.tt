<ul class="nav nav-tabs">
  <li class="nav-item"><%%= link_to tag_icon(:list, pat(:list)), url(:<%= @orm.name_plural %>, :index), class: 'nav-link' %></li>
  <li class="nav-item"><%%= link_to tag_icon(:plus, pat(:new)), url(:<%= @orm.name_plural %>, :new), class: 'nav-link active', 'aria-current' => 'page' %></li>
</ul>
<div class="tabs-content">
  <%% form_for :<%= @orm.name_singular %>, url(:<%= @orm.name_plural %>, :create) do |f| %>
    <%%= partial '<%= @orm.name_plural %>/form', locals: { f: f } %>
  <%% end %>
</div>
