<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%%= @title.present? ? "#{@title} | Padrino Admin" : "#{pat('custom_errors.title')} | Padrino Admin" %></title>
    <script>document.documentElement.dataset.bsTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'</script>
    <%%= favicon_tag 'favicon.ico' %>
    <%%= stylesheet_link_tag 'bootstrap', 'fontawesome', 'application' %>
  </head>

  <body class="bg-body-tertiary">
    <div class="custom-error">
      <div class="custom-error-body"><%%= yield %></div>
      <%%= link_to tag_icon('arrow-left', 'Go back'), '#', onclick: 'history.go(-1); return false;', class: 'btn btn-outline-secondary mt-3' %>
    </div>
  </body>
</html>
